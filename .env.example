# 복사해서 .env.local 로 저장 후 값을 채우세요 (.env.local 은 git에 올리지 않습니다)

# 메일: 주소 도메인으로 SMTP 서버를 자동 선택합니다 (gmail.com → smtp.gmail.com, naver.com → smtp.naver.com)
# 변수 이름이 NAVER_ 로 시작해도 Gmail 주소/앱 비밀번호(16자리)를 넣으면 동작합니다.
NAVER_SMTP_USER=
NAVER_SMTP_PASS=
# 선택: 자동 선택을 덮어쓰고 싶을 때만
SMTP_HOST=
# 비우면 보내는 주소로 발송
MAIL_TO=

# Supabase (서버에서만 사용 - 브라우저에 노출 금지)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 행동 기록(믹스패널): 프로젝트 설정의 Project Token (브라우저에 공개되는 값이지만 저장소에는 올리지 않음)
MIXPANEL_TOKEN=
# EU 프로젝트면 api-eu.mixpanel.com (비우면 api.mixpanel.com)
MIXPANEL_API_HOST=
